###############################################################################
# Linux-targeted C/C++: UTF-8 text with LF line endings
###############################################################################
* text=auto eol=lf

*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.hh text eol=lf
makefile text eol=lf
Makefile text eol=lf
*.mk text eol=lf
*.md text eol=lf
*.txt text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

*.sln text eol=lf
*.vcxproj text eol=lf
*.vcxproj.filters text eol=lf
*.vcxproj.user text eol=lf

###############################################################################
# Diff / merge helpers for VS project files (optional)
###############################################################################
#*.sln       merge=binary
#*.vcxproj   merge=binary
#*.vcproj    merge=binary

###############################################################################
# Binary files
###############################################################################
*.a binary
*.so binary
*.o binary
*.lib binary
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.doc diff=astextplain
*.DOC diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot diff=astextplain
*.DOT diff=astextplain
*.pdf diff=astextplain
*.PDF diff=astextplain
*.rtf diff=astextplain
*.RTF diff=astextplain
